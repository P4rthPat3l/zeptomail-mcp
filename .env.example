# Zoho OAuth app credentials. The refresh token must include:
#   Zeptomail.MailAgents.READ
# plus either:
#   Zeptomail.MailTemplates.All
# or the individual MailTemplates READ/CREATE/UPDATE/DELETE scopes you need.
ZOHO_CLIENT_ID=1000.xxxxx
ZOHO_CLIENT_SECRET=xxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxx

# Pick the Zoho Accounts URL for the OAuth token's data center.
# US: https://accounts.zoho.com
# EU: https://accounts.zoho.eu
# IN: https://accounts.zoho.in
# AU: https://accounts.zoho.com.au
# JP: https://accounts.zoho.jp
# CA: https://accounts.zohocloud.ca
# CN: https://accounts.zoho.com.cn
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

# Official docs use this base URL. Override only if your ZeptoMail account/docs specify another endpoint.
ZEPTOMAIL_API_BASE_URL=https://api.zeptomail.com/v1.1

# Write tools are disabled by default. Set true only after testing read-only access.
ZEPTOMAIL_MCP_ALLOW_WRITES=false

# Optional defense-in-depth allowlist. Leave empty/unset to expose all Agents visible to the OAuth account.
# Values are exact mailagent_key / Agent aliases returned by GET /v1.1/agents.
# Example: ZEPTOMAIL_MCP_ALLOWED_AGENT_KEYS=staging-agent,production-agent
ZEPTOMAIL_MCP_ALLOWED_AGENT_KEYS=
