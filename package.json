{
  "name": "zeptomail-mcp",
  "version": "0.3.7",
  "type": "module",
  "description": "MCP server for safely managing Zoho ZeptoMail templates across multiple Agents",
  "license": "MIT",
  "author": "Parth Patel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P4rthPat3l/zeptomail-mcp.git"
  },
  "homepage": "https://github.com/P4rthPat3l/zeptomail-mcp#readme",
  "keywords": [
    "mcp",
    "zeptomail",
    "zoho",
    "email-templates",
    "model-context-protocol",
    "mcp-server"
  ],
  "bin": {
    "zeptomail-mcp": "./dist/src/cli.js",
    "zeptomail-mcp-login": "./dist/src/login.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "login": "tsx src/login.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
